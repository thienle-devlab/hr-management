<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Layout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style2.css">
    <link href="~/font/css/all.min.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)

    <style>
        /* Thêm CSS để tạo thanh cuộn cho sidebar */
        #sidebar {
            height: 100vh;
            overflow-y: auto;
        }

        /* CSS cho mũi tên */
        .nav-link .arrow {
            transition: transform 0.3s;
            margin: 10px;
        }

        .nav-link.collapsed .arrow {
            transform: rotate(180deg);
        }
    </style>
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="sidebar bg-light p-3" id="sidebar">
            <div class="sidebar-header d-flex justify-content-between align-items-center">
                <h4 class="menu-text">Menu</h4>
                <button class="btn btn-sm btn-toggle" id="sidebarToggle">
                    <i id="toggleIcon" class="fas fa-bars"></i>
                </button>
            </div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#nhanVienSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                        <i class="fas fa-users"></i>
                        <span class="menu-text">Nhân viên</span>
                        <i class="fa-solid fa-chevron-up arrow"></i>
                    </a>
                    <ul class="collapse list-unstyled" id="nhanVienSubmenu">
                        <!-- Nhân viên -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="NhanVien" asp-action="ListNV">
                                <span class="menu-text">Danh sách Nhân viên</span>
                            </a>
                        </li>

                        <!-- Tài khoản -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="TaiKhoan" asp-action="ListTaiKhoan">
                                <span class="menu-text">Tài Khoản</span>
                            </a>
                        </li>

                        <!-- Chấm công -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ChamCong" asp-action="ListChamCong">
                                <span class="menu-text">Chấm công</span>
                            </a>
                        </li>

                        <!-- Nghỉ phép -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="NghiPhep" asp-action="ListNghiPhep">
                                <span class="menu-text">Nghỉ phép</span>
                            </a>
                        </li>
                    </ul>
                </li>


                <!-- Phòng ban -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="PhongBan" asp-action="ListPhongBan">
                        <i class="fa-regular fa-building"></i>
                        <span class="menu-text">Phòng Ban</span>
                    </a>
                </li>

                <!-- Chức vụ -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="ChucVu" asp-action="ListChucVu">
                        <i class="fa-solid fa-arrow-up-right-dots"></i>
                        <span class="menu-text">Chức vụ</span>
                    </a>
                </li>

                <!-- Phân Công -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="PhanCong" asp-action="ListPC">
                        <i class="fa-solid fa-table"></i>
                        <span class="menu-text">Phân Công</span>
                    </a>
                </li>

                <!-- Công việc -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="CongViec" asp-action="ListCongViec">
                        <i class="fa-solid fa-rectangle-list"></i>
                        <span class="menu-text">Công Việc</span>
                    </a>
                </li>

                <!-- Lương (Expandable) -->
                <li class="nav-item">
                    <a class="nav-link collapsed" href="#luongSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                        <i class="fas fa-money-bill-alt"></i>
                        <span class="menu-text">Lương</span>
                        <i class="fa-solid fa-chevron-up arrow"></i>
                    </a>
                    <ul class="collapse list-unstyled" id="luongSubmenu">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Luong" asp-action="ListLuong">
                                <span class="menu-text">Bảng Lương</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="KhauTru" asp-action="ListKhauTru">
                                <span class="menu-text">Khấu Trừ</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="KhauTruLuong" asp-action="ListKhauTruLuong">
                                <span class="menu-text">Khấu Trừ Lương</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PhuCap" asp-action="ListPhuCap">
                                <span class="menu-text">Phụ Cấp</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="LuongPhuCap" asp-action="ListLuongPC">
                                <span class="menu-text">Phụ Cấp Lương</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Thuong" asp-action="ListThuong">
                                <span class="menu-text">Lương Thưởng</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Phat" asp-action="ListPhat">
                                <span class="menu-text">Phạt</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Báo cáo -->
                <li class="nav-item">
                    <a class="nav-link" asp-controller="BaoCao" asp-action="ListBC">
                        <i class="fas fa-chart-line"></i>
                        <span class="menu-text">Báo Cáo</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Main content -->
        <div class="flex-grow-1 p-4">
            <!-- Navbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
                <div class="container-fluid">
                    <a class="navbar-brand" href="#">Dashboard</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto">
                            <!-- Input Tìm kiếm -->
                            <li class="nav-item">
                                <form class="d-flex">
                                    <input class="form-control me-2" type="search" placeholder="Tìm kiếm" aria-label="Search">
                                </form>
                            </li>
                            <li class="nav-item separator"></li> <!-- Line phân cách -->
                            @{
                                var username = Context.Items["Username"] as string;
                                var avatar = Context.Items["Avatar"] as string;
                            }
                            <!-- Avatar Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@avatar" alt="User Avatar" class="avatar"> @username
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="#">Quản lý tài khoản</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Auth")">Đăng xuất</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Content will be inserted here -->
            <div id="content">
                <!-- Nội dung từng trang -->
                @RenderBody()
            </div>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script2.js"></script>
    <script src="~/font/js/all.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha384-vtXRMe3mGCbOeY7l30aIg8H9p3GdeSe4IFlP6G8JMa7o7lXvnz3GFKzPxzJdPfGK" crossorigin="anonymous"></script>

    <!-- Bootstrap JavaScript -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV" crossorigin="anonymous"></script>

</body>
</html>
