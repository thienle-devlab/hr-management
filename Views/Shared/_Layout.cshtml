<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Layout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
    <link href="~/font/css/all.min.css" rel="stylesheet" />
</head>
<body>

    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="sidebar bg-light p-3" id="sidebar">
            <div class="sidebar-header d-flex justify-content-between align-items-center">
                <h4 class="menu-text">Menu</h4>
                <button class="btn btn-sm btn-toggle" id="sidebarToggle">
                    <i id="toggleIcon" class="fas fa-bars"></i>
                </button>
            </div>
            <ul class="nav flex-column">
                <!-- Nhân viên -->
                <li class="nav-item">
                    <a class="nav-link" href="nhan-vien.html">
                        <i class="fas fa-user"></i>
                        <span class="menu-text">Nhân viên</span>
                    </a>
                </li>

                <!-- Chức vụ -->
                <li class="nav-item">
                    <a class="nav-link dropdown-toggle" href="#" id="chucVuDropdown" data-bs-toggle="collapse" data-bs-target="#chucVuSubmenu" aria-expanded="false" aria-controls="chucVuSubmenu">
                        <i class="fas fa-cogs"></i>
                        <span class="menu-text">Chức vụ</span>
                    </a>
                    <ul class="nav flex-column ms-3 collapse" id="chucVuSubmenu">
                        <li><a class="nav-link" href="phong-ban.html">Phòng ban</a></li>
                    </ul>
                </li>

                <!-- Chấm công -->
                <li class="nav-item">
                    <a class="nav-link" href="cham-cong.html">
                        <i class="fas fa-clock"></i>
                        <span class="menu-text">Chấm công</span>
                    </a>
                </li>

                <!-- Nghỉ phép -->
                <li class="nav-item">
                    <a class="nav-link" href="nghi-phep.html">
                        <i class="fas fa-calendar-times"></i>
                        <span class="menu-text">Nghỉ phép</span>
                    </a>
                </li>

                <!-- Phân công -->
                <li class="nav-item">
                    <a class="nav-link dropdown-toggle" href="#" id="phanCongDropdown" data-bs-toggle="collapse" data-bs-target="#phanCongSubmenu" aria-expanded="false" aria-controls="phanCongSubmenu">
                        <i class="fas fa-tasks"></i>
                        <span class="menu-text">Phân công</span>
                    </a>
                    <ul class="nav flex-column ms-3 collapse" id="phanCongSubmenu">
                        <li><a class="nav-link" href="cong-viec.html">Công việc</a></li>
                    </ul>
                </li>

                <!-- Lương -->
                <li class="nav-item">
                    <a class="nav-link dropdown-toggle" href="#" id="luongDropdown" data-bs-toggle="collapse" data-bs-target="#luongSubmenu" aria-expanded="false" aria-controls="luongSubmenu">
                        <i class="fas fa-money-bill-alt"></i>
                        <span class="menu-text">Lương</span>
                    </a>
                    <ul class="nav flex-column ms-3 collapse" id="luongSubmenu">
                        <li><a class="nav-link" href="thuong.html">Thưởng</a></li>
                        <li><a class="nav-link" href="phat.html">Phạt</a></li>
                        <li><a class="nav-link" href="luong-phu-cap.html">Lương phụ cấp</a></li>
                        <li><a class="nav-link" href="khau-tru-luong.html">Khấu trừ lương</a></li>

                        <!-- Lương phụ cấp -->
                        <li class="nav-item">
                            <a class="nav-link dropdown-toggle" href="#" id="luongPhuCapDropdown" data-bs-toggle="collapse" data-bs-target="#luongPhuCapSubmenu" aria-expanded="false" aria-controls="luongPhuCapSubmenu">
                                <span class="menu-text">Lương phụ cấp</span>
                            </a>
                            <ul class="nav flex-column ms-3 collapse" id="luongPhuCapSubmenu">
                                <li><a class="nav-link" href="phu-cap.html">Phụ cấp</a></li>
                            </ul>
                        </li>

                        <!-- Khấu trừ lương -->
                        <li class="nav-item">
                            <a class="nav-link dropdown-toggle" href="#" id="khauTruLuongDropdown" data-bs-toggle="collapse" data-bs-target="#khauTruLuongSubmenu" aria-expanded="false" aria-controls="khauTruLuongSubmenu">
                                <span class="menu-text">Khấu trừ lương</span>
                            </a>
                            <ul class="nav flex-column ms-3 collapse" id="khauTruLuongSubmenu">
                                <li><a class="nav-link" href="khau-tru.html">Khấu trừ</a></li>
                            </ul>
                        </li>
                    </ul>
                </li>

                <!-- Báo cáo -->
                <li class="nav-item">
                    <a class="nav-link" href="bao-cao.html">
                        <i class="fas fa-chart-line"></i>
                        <span class="menu-text">Báo cáo</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Main content -->
        <div class="flex-grow-1 p-4">
            <!-- Navbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
                <div class="container-fluid">
                    <a class="navbar-brand" href="#">Dashboard</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto">
                            <!-- Input Tìm kiếm -->
                            <li class="nav-item">
                                <form class="d-flex">
                                    <input class="form-control me-2" type="search" placeholder="Tìm kiếm" aria-label="Search">
                                </form>
                            </li>
                            <li class="nav-item separator"></li> <!-- Line phân cách -->
                            <!-- Avatar Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="path_to_avatar.jpg" alt="User Avatar" class="avatar">
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="#">Quản lý tài khoản</a></li>
                                    <li><a class="dropdown-item" href="#">Đăng xuất</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>




            <!-- Content will be inserted here -->
            <div id="content">
                <!-- Nội dung từng trang -->
                @RenderBody()
            </div>
        </div>
    </div>
    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="~/font/js/all.min.js"></script>
</body>
</html>
