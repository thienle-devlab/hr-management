@model HR_Management.Models.Thuong

@{
    ViewData["Title"] = "Xóa thưởng";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa thưởng này không?</h2>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Thưởng</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">Thưởng Mã: @Model.MaThuong</h5>
            <p><strong>Mã Nhân Viên:</strong> @Model.MaNhanVien</p>
            <p><strong>Ngày Thưởng:</strong> @Model.NgayThuong.ToString("dd/MM/yyyy")</p>
            <p><strong>Số Tiền Thưởng:</strong> @Model.SoTienThuong.ToString("N0")</p>
            <p><strong>Lý Do Thưởng:</strong> @Model.LyDoThuong</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteThuong">
                <input type="hidden" asp-for="MaThuong" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListThuong", "Thuong")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
