@model IEnumerable<HR_Management.Models.Thuong>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh sách thưởng";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    @if (ViewBag.IsAdmin)
    {
        <p>
            <a asp-action="CreateThuong" class="btn btn-primary mb-3">Thêm Thưởng</a>
        </p>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Thưởng</th>
                    <th scope="col">Mã Nhân Viên</th>
                    <th scope="col">Ngày Thưởng</th>
                    <th scope="col">Số Tiền Thưởng</th>
                    <th scope="col">Lý Do Thưởng</th>
                    @if (ViewBag.IsAdmin)
                    {
                        <th scope="col">Hành Động</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.MaThuong)</td>
                        <td>@Html.DisplayFor(modelItem => item.MaNhanVien)</td>
                        <td>@item.NgayThuong.ToString("dd/MM/yyyy")</td>
                        <td>@item.SoTienThuong.ToString("N0")</td>
                        <td>@Html.DisplayFor(modelItem => item.LyDoThuong)</td>
                        @if (ViewBag.IsAdmin)
                        {
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("EditThuong", new { maThuong = item.MaThuong })" class="btn btn-warning btn-sm">Sửa</a>
                                    <a href="@Url.Action("DeleteThuong", new { maThuong = item.MaThuong })" class="btn btn-danger btn-sm">Xóa</a>
                                </div>
                            </td>
                        }                       
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
