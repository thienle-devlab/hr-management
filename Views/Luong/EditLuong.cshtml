@model HR_Management.Models.Luong
@{
    ViewData["Title"] = "Cập nhật Lương";
}
<h2>Cập nhật Lương</h2>
<h4>Chỉnh sửa thông tin lương</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="EditLuong" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaLuong" />
            <div class="form-group">
                <label asp-for="MaNhanVien" class="control-label"></label>
                <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList" required>
                    <option value="">-- Chọn Nhân Viên --</option>
                </select>
                <span asp-validation-for="MaNhanVien" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LuongCoBan" class="control-label"></label>
                <input asp-for="LuongCoBan" class="form-control" required type="number" min="0" />
                <span asp-validation-for="LuongCoBan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NgayNhanLuong" class="control-label"></label>
                <input asp-for="NgayNhanLuong" class="form-control" type="date" required />
                <span asp-validation-for="NgayNhanLuong" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TrangThai" class="control-label"></label>
                <input asp-for="TrangThai" class="form-control" required />
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-action="ListLuong" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}