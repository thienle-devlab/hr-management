@model HR_Management.Models.Luong

@{
    ViewData["Title"] = "Thêm mới Lương";
}

<h2>Thêm mới Lương</h2>

<h4>Nhập thông tin lương</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="CreateLuong">
            <div class="form-group">
                <label asp-for="MaLuong" class="control-label"></label>
                <input asp-for="MaLuong" class="form-control" />
                <span asp-validation-for="MaLuong" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaNhanVien" class="control-label">Mã nhân viên</label>
                <select asp-for="MaNhanVien" class="form-control" asp-items="@ViewBag.NhanVienList">
                    <option value="">-- Chọn Nhân Viên --</option>
                </select>
                <span asp-validation-for="MaNhanVien" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LuongCoBan" class="control-label"></label>
                <input asp-for="LuongCoBan" class="form-control" />
                <span asp-validation-for="LuongCoBan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NgayNhanLuong" class="control-label"></label>
                <input asp-for="NgayNhanLuong" class="form-control" type="date" />
                <span asp-validation-for="NgayNhanLuong" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TrangThai" class="control-label"></label>
                <input asp-for="TrangThai" class="form-control" />
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

