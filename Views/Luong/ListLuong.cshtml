@model IEnumerable<HR_Management.Models.Luong>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Bảng Lương";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    @if (ViewBag.IsAdmin)
    {
        <p>
            <a asp-action="CreateLuong" class="btn btn-primary mb-3">Thêm Mới Lương</a>
        </p>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Lương</th>
                    <th scope="col">Nhân Viên</th>
                    <th scope="col">Lương Cơ Bản</th>
                    <th scope="col">Ngày Nhận Lương</th>
                    <th scope="col">Trạng Thái</th>
                    @if (ViewBag.IsAdmin)
                    {
                        <th scope="col">Hành Động</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaLuong</td>
                        <td>@item.MaNhanVien</td>
                        <td>@item.LuongCoBan</td>
                        <td>@item.NgayNhanLuong.ToString("dd/MM/yyyy")</td>
                        <td>@item.TrangThai</td>
                        @if (ViewBag.IsAdmin)
                        {
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("EditLuong", new { maLuong = item.MaLuong })" class="btn btn-warning btn-sm">Sửa</a>
                                    <a href="@Url.Action("DeleteLuong", new { maLuong = item.MaLuong })" class="btn btn-danger btn-sm">Xóa</a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
