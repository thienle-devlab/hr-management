@model HR_Management.Models.Luong

@{
    ViewData["Title"] = "Xóa Lương";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa thông tin lương này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Lương</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">Thông tin lương</h5>
            <p><strong>Mã Lương:</strong> @Model.MaLuong</p>
            <p><strong>Nhân Viên:</strong> @Model.MaNhanVienNavigation.TenNhanVien</p>
            <p><strong>Lương Cơ Bản:</strong> @Model.LuongCoBan</p>
            <p><strong>Ngày Nhận Lương:</strong> @Model.NgayNhanLuong.ToString("yyyy-MM-dd")</p>
            <p><strong>Trạng Thái:</strong> @Model.TrangThai</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteLuong">
                <input type="hidden" asp-for="MaLuong" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a asp-action="ListLuong" class="btn btn-secondary btn-lg">Quay lại danh sách</a>
            </form>
        </div>
    </div>
</div>
