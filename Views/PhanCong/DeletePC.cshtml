@model HR_Management.Models.Phancong

@{
    ViewData["Title"] = "Xóa Phân Công";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa phân công này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa phân công</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">Phân công chi tiết</h5>
            <p><strong>Mã Phân Công:</strong> @Model.MaPhanCong</p>
            <p><strong>Mã Nhân Viên:</strong> @Model.MaNhanVien</p>
            <p><strong>Mã Công Việc:</strong> @Model.MaCongViec</p>
            <p><strong>Ngày Bắt Đầu:</strong> @Model.NgayBatDau.ToString("yyyy-MM-dd")</p>
            <p><strong>Ngày Kết Thúc:</strong> @Model.NgayKetThuc.ToString("yyyy-MM-dd")</p>
            <p><strong>Trạng Thái:</strong> @Model.TrangThai</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeletePC">
                <input type="hidden" asp-for="MaPhanCong" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Delete</button>
                <a href="@Url.Action("ListPC", "PhanCong")" class="btn btn-secondary btn-lg">Cancel</a>
            </form>
        </div>
    </div>
</div>
