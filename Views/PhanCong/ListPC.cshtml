@model IEnumerable<HR_Management.Models.Phancong>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Phân Công";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    @if (ViewBag.IsAdmin)
    {
        <p>
            <a asp-action="CreatePC" class="btn btn-primary mb-3">Tạo Mới Phân Công</a>
        </p>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Phân Công</th>
                    <th scope="col">Mã Nhân Viên</th>
                    <th scope="col">Mã Công Việc</th>
                    <th scope="col">Ngày Bắt Đầu</th>
                    <th scope="col">Ngày Kết Thúc</th>
                    <th scope="col">Trạng Thái</th>
                    @if (ViewBag.IsAdmin)
                    {
                        <th scope="col">Hành Động</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var phanCong in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => phanCong.MaPhanCong)</td>
                        <td>@Html.DisplayFor(modelItem => phanCong.MaNhanVien)</td>
                        <td>@Html.DisplayFor(modelItem => phanCong.MaCongViec)</td>
                        <td>@phanCong.NgayBatDau.ToString("dd/MM/yyyy")</td>
                        <td>@phanCong.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                        <td>@Html.DisplayFor(modelItem => phanCong.TrangThai)</td>
                        @if (ViewBag.IsAdmin)
                        {
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("EditPC", new { maPhanCong = phanCong.MaPhanCong })" class="btn btn-warning btn-sm">Sửa</a>
                                    <a href="@Url.Action("DeletePC", new { maPhanCong = phanCong.MaPhanCong })" class="btn btn-danger btn-sm">Xóa</a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
