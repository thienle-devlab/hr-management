@model HR_Management.Models.Nhanvien

@{
    ViewData["Title"] = "Xóa Nhân Viên";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="DeleteNV" method="post">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h4 class="card-title">Xóa Nhân Viên</h4>
            </div>
            <div class="card-body">

                <!-- Mã Nhân Viên -->
                <div class="form-group">
                    <label asp-for="MaNhanVien" class="control-label">Mã Nhân Viên</label>
                    <input asp-for="MaNhanVien" class="form-control" readonly />
                    <span asp-validation-for="MaNhanVien" class="text-danger"></span>
                </div>

                <!-- Tên Nhân Viên -->
                <div class="form-group">
                    <label asp-for="TenNhanVien" class="control-label">Tên Nhân Viên</label>
                    <input asp-for="TenNhanVien" class="form-control" readonly />
                    <span asp-validation-for="TenNhanVien" class="text-danger"></span>
                </div>

                <!-- Ngày Sinh -->
                <div class="form-group">
                    <label asp-for="NgaySinh" class="control-label">Ngày Sinh</label>
                    <input asp-for="NgaySinh" class="form-control" type="date" readonly />
                    <span asp-validation-for="NgaySinh" class="text-danger"></span>
                </div>

                <!-- Giới Tính -->
                <div class="form-group">
                    <label asp-for="GioiTinh" class="control-label">Giới Tính</label>
                    <select asp-for="GioiTinh" class="form-control" disabled>
                        <option value="True">Nam</option>
                        <option value="False">Nữ</option>
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>

                <!-- Ảnh Đại Diện -->
                <div class="form-group">
                    <label asp-for="AnhDaiDien" class="control-label">Ảnh Đại Diện</label>
                    <img src="@Model.AnhDaiDien" alt="Ảnh Đại Diện" class="img-thumbnail" style="max-width: 150px;" />
                </div>

                <!-- Địa Chỉ -->
                <div class="form-group">
                    <label asp-for="DiaChi" class="control-label">Địa Chỉ</label>
                    <input asp-for="DiaChi" class="form-control" readonly />
                    <span asp-validation-for="DiaChi" class="text-danger"></span>
                </div>

                <!-- Số Điện Thoại -->
                <div class="form-group">
                    <label asp-for="SoDienThoai" class="control-label">Số Điện Thoại</label>
                    <input asp-for="SoDienThoai" class="form-control" readonly />
                    <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label asp-for="Email" class="control-label">Email</label>
                    <input asp-for="Email" class="form-control" readonly />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- CCCD -->
                <div class="form-group">
                    <label asp-for="Cccd" class="control-label">CCCD</label>
                    <input asp-for="Cccd" class="form-control" readonly />
                    <span asp-validation-for="Cccd" class="text-danger"></span>
                </div>

                <!-- Chức Vụ -->
                <div class="form-group">
                    <label asp-for="MaChucVu" class="control-label">Chức Vụ</label>
                    <input asp-for="MaChucVu" class="form-control" readonly />
                    <span asp-validation-for="MaChucVu" class="text-danger"></span>
                </div>

            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-danger btn-lg">Xóa</button>
                <a href="@Url.Action("ListNV", "Nhanvien")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
