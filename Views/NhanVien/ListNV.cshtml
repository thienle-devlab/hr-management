@model IEnumerable<HR_Management.Models.Nhanvien>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Nhân Viên";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="flex mb-3 justify-between">
        @if (ViewBag.IsAdmin)
        {
            <a asp-action="CreateNV" class="btn btn-primary">Thêm Mới Nhân Viên</a>
        }
        <a href="@Url.Action("ExportToExcel", "NhanVien")" class="btn btn-success">Xuất Excel</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Nhân Viên</th>
                    <th scope="col">Tên Nhân Viên</th>
                    <th scope="col">Chức Vụ</th>
                    
                    @* @if (ViewBag.IsAdmin)
                    {
                        <th scope="col">Hành Động</th>
                    } *@
                </tr>
            </thead>
            <tbody>
                @foreach (var nhanVien in Model)
                {
                    <tr data-bs-toggle="collapse" data-bs-target="#details-@nhanVien.MaNhanVien" class="accordion-toggle">
                        <td>@Html.DisplayFor(modelItem => nhanVien.MaNhanVien)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.TenNhanVien)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.MaChucVu)</td>
                        
                        @* @if (ViewBag.IsAdmin)
                        {
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("EditNV", new { maNhanVien = nhanVien.MaNhanVien })" class="btn btn-warning btn-sm">Sửa</a>
                                    <a href="@Url.Action("DeleteNV", new { maNhanVien = nhanVien.MaNhanVien })" class="btn btn-danger btn-sm">Xóa</a>
                                </div>
                            </td>
                        } *@
                    </tr>
                    <tr>
                        <td colspan="4" class="hiddenRow">
                            <div class="accordion-body collapse p-3" id="details-@nhanVien.MaNhanVien">
                                <div class="card card-body m-2 loading-placeholder flex justify-center items-center">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="sr-only">Đang tải...</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>

                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha384-vtXRMe3mGCbOeY7l30aIg8H9p3GdeSe4IFlP6G8JMa7o7lXvnz3GFKzPxzJdPfGK" crossorigin="anonymous"></script>

    <!-- Bootstrap JavaScript -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV" crossorigin="anonymous"></script>

    <!-- Mã JavaScript tùy chỉnh của bạn -->
    <script>
        $(document).ready(function () {
            // Kiểm tra nếu jQuery đã được tải thành công
            if (typeof $ === 'undefined' || typeof $.ajax === 'undefined') {
                console.error('jQuery hoặc $.ajax không được tải đúng cách.');
            } else {
                console.log('jQuery đã được tải thành công.');
            }

            // Lắng nghe sự kiện click của các hàng nhân viên để tải chi tiết
            $('tr.accordion-toggle').on('click', function () {
                const button = $(this);
                const employeeId = button.data('bs-target').split('-')[1];
                const detailsDiv = $(`#details-${employeeId}`);
                const collapseContent = detailsDiv.find('.card-body');

                // Nếu chưa tải dữ liệu chi tiết
                if (!detailsDiv.data('loaded')) {
                    $.ajax({
                        url: '@Url.Action("GetEmployeeDetails", "NhanVien")',
                        type: 'GET',
                        data: { maNhanVien: employeeId },
                        success: function (data) {
                            collapseContent.html(data);
                            detailsDiv.data('loaded', true); // Đánh dấu là đã tải dữ liệu
                        },
                        error: function () {
                            collapseContent.html(`
                                                    <div class="alert alert-danger">
                                                        Không thể tải thông tin chi tiết nhân viên.
                                                    </div>
                                                `);
                        }
                    });
                }
            });
        });
    </script>
}

