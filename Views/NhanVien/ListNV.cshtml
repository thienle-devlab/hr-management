@model IEnumerable<HR_Management.Models.Nhanvien>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Nhân Viên";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="flex mb-3 justify-between">
        @if (ViewBag.IsAdmin)
        {
            <a asp-action="CreateNV" class="btn btn-primary">Thêm Mới Nhân Viên</a>
        }
        <a href="@Url.Action("ExportToExcel", "NhanVien")" class="btn btn-success">Xuất Excel</a>
    </div>


    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Nhân Viên</th>
                    <th scope="col">Tên Nhân Viên</th>
                    <th scope="col">Ngày Sinh</th>
                    <th scope="col">Giới Tính</th>
                    <th scope="col">Ảnh Đại Diện</th>
                    <th scope="col">Địa Chỉ</th>
                    <th scope="col">Số Điện Thoại</th>
                    <th scope="col">Email</th>
                    <th scope="col">CCCD</th>
                    <th scope="col">Mã Chức Vụ</th>
                    @if (ViewBag.IsAdmin)
                    {
                        <th scope="col">Hành Động</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var nhanVien in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => nhanVien.MaNhanVien)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.TenNhanVien)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.NgaySinh)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.GioiTinh)</td>
                        <td>
                            <img src="@Url.Content(nhanVien.AnhDaiDien)" alt="Ảnh Đại Diện" class="img-thumbnail" style="max-width: 50px; height: auto;" />
                        </td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.DiaChi)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.SoDienThoai)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.Email)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.Cccd)</td>
                        <td>@Html.DisplayFor(modelItem => nhanVien.MaChucVu)</td>
                        @if (ViewBag.IsAdmin)
                        {
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("EditNV", new { maNhanVien = nhanVien.MaNhanVien })" class="btn btn-warning btn-sm">Sửa</a>
                                    <a href="@Url.Action("DeleteNV", new { maNhanVien = nhanVien.MaNhanVien })" class="btn btn-danger btn-sm">Xóa</a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
