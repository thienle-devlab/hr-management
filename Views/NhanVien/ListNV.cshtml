@model IEnumerable<HR_Management.Models.Nhanvien>

<h2>Danh sách nhân viên</h2>

@if (ViewBag.IsAdmin)
{
    <a asp-action="CreateNV" class="btn btn-primary">Thêm mới</a>
}

<!-- Nút Xuất Excel -->
<a href="@Url.Action("ExportToExcel", "NhanVien")" class="btn btn-success">Xuất Excel</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tên</th>
            <th>Ngày sinh</th>
            <th>Giới tính</th>
            <th>Ảnh đại diện</th>
            <th>Địa chỉ</th>
            <th>Số điện thoại</th>
            <th>Email</th>
            <th>CCCD</th>
            <th>Mã chức vụ</th>
            @if (ViewBag.IsAdmin)
            {
                <th>Thao tác</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var nhanVien in Model)
        {
            <tr>
                <td>@nhanVien.MaNhanVien</td>
                <td>@nhanVien.TenNhanVien</td>
                <td>@nhanVien.NgaySinh</td>
                <td>@nhanVien.GioiTinh</td>
                <td>@nhanVien.AnhDaiDien</td>
                <td>@nhanVien.DiaChi</td>
                <td>@nhanVien.SoDienThoai</td>
                <td>@nhanVien.Email</td>
                <td>@nhanVien.Cccd</td>
                <td>@nhanVien.MaChucVu</td>
                @if (ViewBag.IsAdmin)
                {
                    <td>
                        <a asp-action="EditNV" asp-route-id="@nhanVien.MaNhanVien">Sửa</a> |
                        <a asp-action="DeleteNV" asp-route-id="@nhanVien.MaNhanVien">Xóa</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
