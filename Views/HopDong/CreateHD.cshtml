@model HR_Management.Models.Hopdong

@{
    ViewData["Title"] = "Tạo Hợp Đồng";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="CreateHD">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Hợp Đồng Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Hợp Đồng -->
                <div class="form-group">
                    <label asp-for="MaHopDong" class="control-label">Mã Hợp Đồng</label>
                    <input asp-for="MaHopDong" class="form-control" />
                    <span asp-validation-for="MaHopDong" class="text-danger"></span>
                </div>

                <!-- Nhân viên -->
                <div class="form-group">
                    <label for="MaNhanVien">Nhân viên</label>
                    <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList"></select>
                    <span asp-validation-for="MaNhanVien" class="text-danger"></span>
                </div>

                <!-- Loại Hợp Đồng -->
                <div class="form-group">
                    <label for="LoaiHopDong">Loại Hợp Đồng</label>
                    <input asp-for="LoaiHopDong" class="form-control" />
                    <span asp-validation-for="LoaiHopDong" class="text-danger"></span>
                </div>

                <!-- Ngày Ký -->
                <div class="form-group">
                    <label for="NgayKy">Ngày Ký</label>
                    <input asp-for="NgayKy" class="form-control" type="date" />
                    <span asp-validation-for="NgayKy" class="text-danger"></span>
                </div>

                <!-- Ngày Bắt Đầu -->
                <div class="form-group">
                    <label for="NgayBatDau">Ngày Bắt Đầu</label>
                    <input asp-for="NgayBatDau" class="form-control" type="date" />
                    <span asp-validation-for="NgayBatDau" class="text-danger"></span>
                </div>

                <!-- Ngày Kết Thúc -->
                <div class="form-group">
                    <label for="NgayKetThuc">Ngày Kết Thúc</label>
                    <input asp-for="NgayKetThuc" class="form-control" type="date" />
                    <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                </div>

                <!-- Mức Lương -->
                <div class="form-group">
                    <label for="MucLuong">Mức Lương</label>
                    <input asp-for="MucLuong" class="form-control" />
                    <span asp-validation-for="MucLuong" class="text-danger"></span>
                </div>

                <!-- Trạng Thái -->
                <div class="form-group">
                    <label for="TrangThai">Trạng Thái</label>
                    <input asp-for="TrangThai" class="form-control" />
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Tạo Hợp Đồng</button>
                <a href="@Url.Action("ListHD", "HopDong")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
