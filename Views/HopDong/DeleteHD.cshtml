@model HR_Management.Models.Hopdong

@{
    ViewData["Title"] = "Xóa Hợp Đồng";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa hợp đồng này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa hợp đồng</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">Hợp Đồng @Model.MaHopDong</h5>
            <p><strong>Mã Hợp Đồng:</strong> @Model.MaHopDong</p>
            <p><strong>Nhân viên:</strong> @Model.MaNhanVien</p>
            <p><strong>Loại Hợp Đồng:</strong> @Model.LoaiHopDong</p>
            <p><strong>Ngày Bắt Đầu:</strong> @Model.NgayBatDau</p>
            <p><strong>Ngày Kết Thúc:</strong> @Model.NgayKetThuc</p>
            <p><strong>Ngày Ký:</strong> @Model.NgayKy</p>
            <p><strong>Trạng Thái:</strong> @Model.TrangThai</p>
            <p><strong>Mức Lương:</strong> @Model.MucLuong</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteHD">
                <input type="hidden" name="maHopDong" value="@Model.MaHopDong" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListHD", "HopDong")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
