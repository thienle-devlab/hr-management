@model IEnumerable<HR_Management.Models.Hopdong>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Hợp Đồng";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    @if (ViewBag.IsAdmin)
    {
        <p>
            <a asp-action="CreateHD" class="btn btn-primary mb-3">Tạo Mới Hợp Đồng</a>
        </p>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Hợp Đồng</th>
                    <th scope="col">Mã Nhân Viên</th>
                    <th scope="col">Loại Hợp Đồng</th>
                    <th scope="col">Ngày Ký</th>
                    <th scope="col">Ngày Bắt Đầu</th>
                    <th scope="col">Ngày Kết Thúc</th>
                    <th scope="col">Mức Lương</th>
                    <th scope="col">Trạng Thái</th>
                    @if (ViewBag.IsAdmin)
                    {
                        <th scope="col">Hành Động</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.MaHopDong)</td>
                        <td>@Html.DisplayFor(modelItem => item.MaNhanVien)</td>
                        <td>@Html.DisplayFor(modelItem => item.LoaiHopDong)</td>
                        <td>@Html.DisplayFor(modelItem => item.NgayKy)</td>
                        <td>@Html.DisplayFor(modelItem => item.NgayBatDau)</td>
                        <td>@Html.DisplayFor(modelItem => item.NgayKetThuc)</td>
                        <td>@Html.DisplayFor(modelItem => item.MucLuong)</td>
                        <td>@Html.DisplayFor(modelItem => item.TrangThai)</td>
                        @if (ViewBag.IsAdmin)
                        {
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("EditHD", new { maHopDong = item.MaHopDong })" class="btn btn-warning btn-sm">Sửa</a>
                                    <a href="@Url.Action("DeleteHD", new { maHopDong = item.MaHopDong })" class="btn btn-danger btn-sm">Xóa</a>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
