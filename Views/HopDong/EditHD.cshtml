@model HR_Management.Models.Hopdong

<h2>Sửa Hợp Đồng</h2>

<form asp-action="EditHD">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="MaHopDong" class="control-label"></label>
        <input asp-for="MaHopDong" class="form-control" readonly />
        <span asp-validation-for="MaHopDong" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaNhanVien" class="control-label"></label>
        <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList"></select>
        <span asp-validation-for="MaNhanVien" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LoaiHopDong" class="control-label"></label>
        <input asp-for="LoaiHopDong" class="form-control" />
        <span asp-validation-for="LoaiHopDong" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NgayKy" class="control-label"></label>
        <input asp-for="NgayKy" class="form-control" />
        <span asp-validation-for="NgayKy" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NgayBatDau" class="control-label"></label>
        <input asp-for="NgayBatDau" class="form-control" />
        <span asp-validation-for="NgayBatDau" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NgayKetThuc" class="control-label"></label>
        <input asp-for="NgayKetThuc" class="form-control" />
        <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MucLuong" class="control-label"></label>
        <input asp-for="MucLuong" class="form-control" />
        <span asp-validation-for="MucLuong" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TrangThai" class="control-label"></label>
        <input asp-for="TrangThai" class="form-control" />
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Lưu" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="ListHD" class="btn btn-secondary">Quay lại danh sách</a>
</div>
