@model HR_Management.Models.Khautruluong

@{
    ViewData["Title"] = "Tạo Khấu Trừ Lương";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="CreateKhauTruLuong" method="post">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Khấu Trừ Lương Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Khấu Trừ Lương -->
                <div class="form-group">
                    <label asp-for="MaKhauTruLuong" class="control-label">Mã Khấu Trừ Lương</label>
                    <input asp-for="MaKhauTruLuong" class="form-control" />
                    <span asp-validation-for="MaKhauTruLuong" class="text-danger"></span>
                </div>

                <!-- Mã Lương -->
                <div class="form-group">
                    <label for="MaLuong">Mã lương</label>
                    <select asp-for="MaLuong" class="form-control" asp-items="ViewBag.LuongList"></select>
                    <span asp-validation-for="MaLuong" class="text-danger"></span>
                </div>

                <!-- Mã Khấu Trừ -->
                <div class="form-group">
                    <label for="MaKhauTru">Khấu trừ</label>
                    <select asp-for="MaKhauTru" class="form-control" asp-items="ViewBag.KhauTruList"></select>
                    <span asp-validation-for="MaKhauTru" class="text-danger"></span>
                </div>

                <!-- Số Tiền -->
                <div class="form-group">
                    <label for="KhoanKhauTru">Số tiền</label>
                    <input type="number" asp-for="KhoanKhauTru" class="form-control" />
                    <span asp-validation-for="KhoanKhauTru" class="text-danger"></span>
                </div>

                <!-- Ngày Áp Dụng -->
                <div class="form-group">
                    <label for="NgayApDung">Ngày áp dụng</label>
                    <input type="date" asp-for="NgayApDung" class="form-control" />
                    <span asp-validation-for="NgayApDung" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Tạo Khấu Trừ Lương</button>
                <a href="@Url.Action("ListKhauTruLuong", "KhauTruLuong")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
