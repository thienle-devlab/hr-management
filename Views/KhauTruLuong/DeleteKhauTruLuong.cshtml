@model HR_Management.Models.Khautruluong

@{
    ViewData["Title"] = "Xóa Khấu Trừ Lương";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa khấu trừ lương này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Khấu Trừ Lương</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">Chi tiết Khấu Trừ Lương</h5>
            <p><strong>Mã Khấu Trừ Lương:</strong> @Model.MaKhauTruLuong</p>
            <p><strong>Mã Nhân Viên:</strong> @Model.MaNhanVien</p>
            <p><strong>Mã Khấu Trừ:</strong> @Model.MaKhauTru</p>
            <p><strong>Số Tiền:</strong> @Model.KhoanKhauTru</p>
            <p><strong>Ngày Áp Dụng:</strong> @Model.NgayApDung.ToString("yyyy-MM-dd")</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteKhauTruLuong">
                <input type="hidden" name="MaKhauTruLuong" value="@Model.MaKhauTruLuong" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListKhauTruLuong", "KhauTruLuong")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
