@model HR_Management.Models.Khautruluong

@{
    ViewData["Title"] = "Xóa Khấu trừ lương";
}

<h2>@ViewData["Title"]</h2>

<h3>Bạn có chắc chắn muốn xóa chức vụ này không?</h3>

<div>
    <h4>Xóa Khấu trừ lương</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Mã khấu trừ lương</dt>
        <dd class="col-sm-10">@Model.MaKhauTruLuong</dd>

        <dt class="col-sm-2">Mã Lương</dt>
        <dd class="col-sm-10">@Model.MaLuong</dd>

        <dt class="col-sm-2">Mã khấu trừ</dt>
        <dd class="col-sm-10">@Model.MaKhauTru</dd>

        <dt class="col-sm-2">Số tiền</dt>
        <dd class="col-sm-10">@Model.KhoanKhauTru</dd>

        <dt class="col-sm-2">Ngày áp dụng</dt>
        <dd class="col-sm-10">@Model.NgayApDung</dd>
    </dl>

    <form asp-action="DeleteKhauTruLuong" method="post">
        <input type="hidden" name="MaKhauTruLuong" value="@Model.MaKhauTruLuong" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="ListKhauTruLuong" class="btn btn-secondary">Hủy</a>
    </form>
</div>
