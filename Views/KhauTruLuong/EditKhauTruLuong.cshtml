@model HR_Management.Models.Khautruluong

@{
    ViewData["Title"] = "Sửa Khấu Trừ Lương";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="EditKhauTruLuong" method="post">
        <div class="card">
            <div class="card-header bg-warning text-white">
                <h4 class="card-title">Chỉnh sửa thông tin khấu trừ lương</h4>
            </div>
            <div class="card-body">
                <input type="hidden" asp-for="MaKhauTruLuong" />

                <!-- Mã Lương -->
                <div class="form-group">
                    <label for="MaNhanVien">Nhân viên</label>
                    <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList"></select>
                    <span asp-validation-for="MaNhanVien" class="text-danger"></span>
                </div>

                <!-- Mã Khấu Trừ -->
                <div class="form-group">
                    <label for="MaKhauTru">Mã khấu trừ</label>
                    <select asp-for="MaKhauTru" class="form-control" asp-items="ViewBag.KhauTruList"></select>
                    <span asp-validation-for="MaKhauTru" class="text-danger"></span>
                </div>

                <!-- Số Tiền -->
                <div class="form-group">
                    <label for="KhoanKhauTru">Số tiền</label>
                    <input type="number" asp-for="KhoanKhauTru" class="form-control" />
                    <span asp-validation-for="KhoanKhauTru" class="text-danger"></span>
                </div>

                <!-- Ngày Áp Dụng -->
                <div class="form-group">
                    <label for="NgayApDung">Ngày áp dụng</label>
                    <input type="date" asp-for="NgayApDung" class="form-control" />
                    <span asp-validation-for="NgayApDung" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-success btn-lg">Lưu Thay Đổi</button>
                <a href="@Url.Action("ListKhauTruLuong", "KhauTruLuong")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
