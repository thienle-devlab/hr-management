@model HR_Management.Models.Baocao

@{
    ViewData["Title"] = "Xóa Báo Cáo";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa báo cáo này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa báo cáo</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.TenBaoCao</h5>
            <p><strong>Ma Báo Cáo:</strong> @Model.MaBaoCao</p>
            <p><strong>Loại Báo Cáo:</strong> @Model.LoaiBaoCao</p>
            <p><strong>Trạng Thái Báo Cáo:</strong> @Model.TrangThaiBaoCao</p>
            <p><strong>Ngày Tạo Báo Cáo:</strong> @Model.NgayTaoBaoCao.ToString("yyyy-MM-dd")</p>
            <p><strong>Dữ Liệu Báo Cáo:</strong> @Model.DuLieuBaoCao</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteBaoCao">
                <input type="hidden" name="maBaoCao" value="@Model.MaBaoCao" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Delete</button>
                <a href="@Url.Action("ListBC", "BaoCao")" class="btn btn-secondary btn-lg">Cancel</a>
            </form>
        </div>
    </div>
</div>
