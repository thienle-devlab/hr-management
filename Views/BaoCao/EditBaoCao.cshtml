@model HR_Management.Models.Baocao

@{
    ViewData["Title"] = "Sửa Báo Cáo";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="EditBaoCao">
        <div class="card">
            <div class="card-header bg-warning text-white">
                <h4 class="card-title">Chỉnh sửa thông tin báo cáo</h4>
            </div>
            <div class="card-body">

                <!-- Mã Báo Cáo -->
                <div class="form-group">
                    <label asp-for="MaBaoCao" class="control-label">Mã Báo Cáo</label>
                    <input asp-for="MaBaoCao" class="form-control" readonly />
                    <span asp-validation-for="MaBaoCao" class="text-danger"></span>
                </div>

                <!-- Nhân viên -->
                <div class="form-group">
                    <label for="MaNhanVien">Nhân viên</label>
                    <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList"></select>
                    <span asp-validation-for="MaNhanVien" class="text-danger"></span>
                </div>

                <!-- Tên Báo Cáo -->
                <div class="form-group">
                    <label for="TenBaoCao">Tên Báo Cáo</label>
                    <input asp-for="TenBaoCao" class="form-control" />
                    <span asp-validation-for="TenBaoCao" class="text-danger"></span>
                </div>

                <!-- Dữ liệu Báo Cáo -->
                <div class="form-group">
                    <label for="DuLieuBaoCao">Dữ Liệu Báo Cáo</label>
                    <textarea asp-for="DuLieuBaoCao" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="DuLieuBaoCao" class="text-danger"></span>
                </div>

                <!-- Loại Báo Cáo -->
                <div class="form-group">
                    <label for="LoaiBaoCao">Loại Báo Cáo</label>
                    <input asp-for="LoaiBaoCao" class="form-control" />
                    <span asp-validation-for="LoaiBaoCao" class="text-danger"></span>
                </div>

                <!-- Trạng Thái Báo Cáo -->
                <div class="form-group">
                    <label for="TrangThaiBaoCao">Trạng Thái Báo Cáo</label>
                    <input asp-for="TrangThaiBaoCao" class="form-control" />
                    <span asp-validation-for="TrangThaiBaoCao" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-success btn-lg">Lưu Thay Đổi</button>
                <a href="@Url.Action("ListBC", "BaoCao")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>

