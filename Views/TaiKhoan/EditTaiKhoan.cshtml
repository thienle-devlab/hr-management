@model HR_Management.Models.Taikhoan
@{
    ViewBag.Title = "Chỉnh Sửa Tài Khoản";
}

<h2>Chỉnh Sửa Tài Khoản</h2>

<form asp-action="EditTaiKhoan">
    <input type="hidden" asp-for="Username" />
    <input type="hidden" name="currentPasswordHash" value="@Model.Password" />

    <div class="form-group">
        <label>Tên Tài Khoản</label>
        <input asp-for="Username" class="form-control" readonly />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Mật Khẩu</label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MaNhanVien" class="control-label">Mã nhân viên</label>
        <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList">
            <option value="">-- Chọn Nhân Viên --</option>
        </select>
        <span asp-validation-for="MaNhanVien" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Trạng Thái</label>
        <input asp-for="TrangThai" class="form-control" />
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu Thay Đổi</button>
    <a asp-action="ListTaiKhoan" class="btn btn-secondary">Hủy</a>
</form>
