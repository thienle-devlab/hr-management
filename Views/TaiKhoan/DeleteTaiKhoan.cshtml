@model HR_Management.Models.Taikhoan

@{
    ViewBag.Title = "Xóa Tài Khoản";
}

<h2>Xóa Tài Khoản</h2>

<h3>Bạn có chắc chắn muốn xóa tài khoản này?</h3>

<div>
    <h4>Tài Khoản</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Username)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Username)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.MaNhanVien)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.MaNhanVien)
        </dd>
    </dl>

    <form asp-action="DeleteTaiKhoan" method="post">
        <input type="hidden" asp-for="Username" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        @Html.ActionLink("Quay lại", "ListTaiKhoan", null, new { @class = "btn btn-secondary" })
    </form>
</div>
