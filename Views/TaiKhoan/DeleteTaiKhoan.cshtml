@model HR_Management.Models.Taikhoan

@{
    ViewData["Title"] = "Xóa Tài Khoản";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa tài khoản này không?</h2>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Tài Khoản</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.Username</h5>
            <p><strong>Mã Nhân Viên:</strong> @Model.MaNhanVien</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteTaiKhoan">
                <input type="hidden" asp-for="Username" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListTaiKhoan", "TaiKhoan")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
