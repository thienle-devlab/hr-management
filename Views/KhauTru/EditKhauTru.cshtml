@model HR_Management.Models.Khautru

@{
    ViewData["Title"] = "Sửa Khấu Trừ";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="EditKhauTru">
        <div class="card">
            <div class="card-header bg-warning text-white">
                <h4 class="card-title">Chỉnh sửa thông tin khấu trừ</h4>
            </div>
            <div class="card-body">

                <!-- Mã Khấu Trừ -->
                <div class="form-group">
                    <label asp-for="MaKhauTru" class="control-label">Mã Khấu Trừ</label>
                    <input asp-for="MaKhauTru" class="form-control" readonly />
                    <span asp-validation-for="MaKhauTru" class="text-danger"></span>
                </div>

                <!-- Tên Khấu Trừ -->
                <div class="form-group">
                    <label for="TenKhauTru">Tên Khấu Trừ</label>
                    <input asp-for="TenKhauTru" class="form-control" />
                    <span asp-validation-for="TenKhauTru" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-success btn-lg">Lưu Thay Đổi</button>
                <a href="@Url.Action("ListKhauTru", "KhauTru")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
