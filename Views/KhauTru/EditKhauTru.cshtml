@model HR_Management.Models.Khautru

@{
    ViewData["Title"] = "Chỉnh sửa Khấu trừ";
}

<h2>Chỉnh sửa Khấu trừ</h2>

<form asp-action="EditKhauTru" method="post">
    <input type="hidden" asp-for="MaKhauTru" />
    <div class="form-group">
        <label for="TenKhauTru">Tên Khấu Trừ</label>
        <input asp-for="TenKhauTru" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="ListKhauTru" class="btn btn-secondary">Hủy</a>
</form>