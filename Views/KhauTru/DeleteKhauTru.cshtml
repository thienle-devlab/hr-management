@model HR_Management.Models.Khautru

@{
    ViewData["Title"] = "Xóa Khấu Trừ";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa khấu trừ này không?</h2>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Khấu Trừ</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.TenKhauTru</h5>
            <p><strong>Mã Khấu Trừ:</strong> @Model.MaKhauTru</p>
            <p><strong>Tên Khấu Trừ:</strong> @Model.TenKhauTru</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteKhauTru">
                <input type="hidden" name="maKhauTru" value="@Model.MaKhauTru" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListKhauTru", "KhauTru")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
