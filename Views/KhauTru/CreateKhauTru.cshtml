@model HR_Management.Models.Khautru

@{
    ViewData["Title"] = "Tạo Khấu Trừ";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="CreateKhauTru" method="post">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Khấu Trừ Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Khấu Trừ -->
                <div class="form-group">
                    <label asp-for="MaKhauTru" class="control-label">Mã Khấu Trừ</label>
                    <input asp-for="MaKhauTru" class="form-control" />
                    <span asp-validation-for="MaKhauTru" class="text-danger"></span>
                </div>

                <!-- Tên Khấu Trừ -->
                <div class="form-group">
                    <label for="TenKhauTru">Tên Khấu Trừ</label>
                    <input asp-for="TenKhauTru" class="form-control" />
                    <span asp-validation-for="TenKhauTru" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Tạo Khấu Trừ</button>
                <a href="@Url.Action("ListKhauTru", "KhauTru")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
