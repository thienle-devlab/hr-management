@model HR_Management.Models.Congviec

@{
    ViewData["Title"] = "Xóa Công Việc";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa công việc này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Công Việc</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.TenCongViec</h5>
            <p><strong>Mã Công Việc:</strong> @Model.MaCongViec</p>
            <p><strong>Mô Tả Công Việc:</strong> @Model.MoTaCongViec</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteCV">
                <input type="hidden" name="MaCongViec" value="@Model.MaCongViec" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListCongViec", "CongViec")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
