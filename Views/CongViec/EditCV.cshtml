@model HR_Management.Models.Congviec

@{
    ViewData["Title"] = "Edit Công Việc";
}

<h2>Edit Công Việc</h2>

<h4>Công Việc</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditCV">
            <div class="form-group">
                <label asp-for="MaCongViec" class="control-label"></label>
                <input asp-for="MaCongViec" class="form-control" readonly />
                <span asp-validation-for="MaCongViec" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TenCongViec" class="control-label"></label>
                <input asp-for="TenCongViec" class="form-control" />
                <span asp-validation-for="TenCongViec" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MoTaCongViec" class="control-label"></label>
                <textarea asp-for="MoTaCongViec" class="form-control"></textarea>
                <span asp-validation-for="MoTaCongViec" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="ListCongViec">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}