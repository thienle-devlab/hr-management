@model IEnumerable<HR_Management.Models.Congviec>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Công Việc";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <p>
        <a asp-action="CreateCV" class="btn btn-primary mb-3">Tạo Mới Công Việc</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Công Việc</th>
                    <th scope="col">Tên Công Việc</th>
                    <th scope="col">Mô Tả Công Việc</th>
                    <th scope="col">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.MaCongViec)</td>
                        <td>@Html.DisplayFor(modelItem => item.TenCongViec)</td>
                        <td>@Html.DisplayFor(modelItem => item.MoTaCongViec)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("EditCV", new { maCongViec = item.MaCongViec })" class="btn btn-warning btn-sm">Sửa</a>
                                <a href="@Url.Action("DeleteCV", new { maCongViec = item.MaCongViec })" class="btn btn-danger btn-sm">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
