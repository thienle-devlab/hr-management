@model HR_Management.Models.Congviec

@{
    ViewData["Title"] = "Tạo Công Việc";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="CreateCV">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Công Việc Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Công Việc -->
                <div class="form-group">
                    <label asp-for="MaCongViec" class="control-label">Mã Công Việc</label>
                    <input asp-for="MaCongViec" class="form-control" />
                    <span asp-validation-for="MaCongViec" class="text-danger"></span>
                </div>

                <!-- Tên Công Việc -->
                <div class="form-group">
                    <label for="TenCongViec">Tên Công Việc</label>
                    <input asp-for="TenCongViec" class="form-control" />
                    <span asp-validation-for="TenCongViec" class="text-danger"></span>
                </div>

                <!-- Mô Tả Công Việc -->
                <div class="form-group">
                    <label for="MoTaCongViec">Mô Tả Công Việc</label>
                    <textarea asp-for="MoTaCongViec" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="MoTaCongViec" class="text-danger"></span>
                </div>

            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Tạo Công Việc</button>
                <a href="@Url.Action("ListCongViec", "CongViec")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
