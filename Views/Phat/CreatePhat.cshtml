@model HR_Management.Models.Phat

@{
    ViewData["Title"] = "Thêm Phạt";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="CreatePhat" method="post">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Phạt Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Phạt -->
                <div class="form-group">
                    <label asp-for="MaPhat" class="control-label">Mã Phạt</label>
                    <input asp-for="MaPhat" class="form-control" />
                    <span asp-validation-for="MaPhat" class="text-danger"></span>
                </div>

                <!-- Mã Lương -->
                <div class="form-group">
                    <label for="MaNhanVien">Nhân Viên</label>
                    <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList">
                        <option value="">-- Chọn Nhân Viên --</option>
                    </select>
                    <span asp-validation-for="MaNhanVien" class="text-danger"></span>
                </div>

                <!-- Ngày Phạt -->
                <div class="form-group">
                    <label for="NgayPhat">Ngày Phạt</label>
                    <input type="date" asp-for="NgayPhat" class="form-control" />
                    <span asp-validation-for="NgayPhat" class="text-danger"></span>
                </div>

                <!-- Số Tiền Phạt -->
                <div class="form-group">
                    <label for="SoTienPhat">Số Tiền Phạt</label>
                    <input type="number" asp-for="SoTienPhat" class="form-control" />
                    <span asp-validation-for="SoTienPhat" class="text-danger"></span>
                </div>

                <!-- Lý Do Phạt -->
                <div class="form-group">
                    <label for="LyDoPhat">Lý Do Phạt</label>
                    <textarea asp-for="LyDoPhat" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="LyDoPhat" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Thêm Phạt</button>
                <a href="@Url.Action("ListPhat", "Phat")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
