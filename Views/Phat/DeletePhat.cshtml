@model HR_Management.Models.Phat

@{
    ViewData["Title"] = "Xóa Phạt";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa phạt này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Phạt</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">Phạt Mã: @Model.MaPhat</h5>
            <p><strong>Mã Nhân Viên:</strong> @Model.MaNhanVien</p>
            <p><strong>Ngày Phạt:</strong> @Model.NgayPhat.ToString("dd/MM/yyyy")</p>
            <p><strong>Số Tiền Phạt:</strong> @Model.SoTienPhat</p>
            <p><strong>Lý Do Phạt:</strong> @Model.LyDoPhat</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeletePhat">
                <input type="hidden" asp-for="MaPhat" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListPhat", "Phat")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
