@model HR_Management.Models.Nghiphep

@{
    ViewData["Title"] = "Xác nhận xóa";
}

<h1>Xác nhận xóa</h1>

<h3>Bạn có chắc chắn muốn xóa nghỉ phép này?</h3>

<div>
    <h4>Nghỉ Phép</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Mã Nghỉ Phép
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaNghiPhep)
        </dd>
        <dt class="col-sm-2">
            Mã Nhân Viên
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaNhanVien)
        </dd>
        <dt class="col-sm-2">
            Ngày Bắt Đầu
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NgayBatDau)
        </dd>
        <dt class="col-sm-2">
            Ngày Kết Thúc
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NgayKetThuc)
        </dd>
        <dt class="col-sm-2">
            Lý Do
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LyDo)
        </dd>
        <dt class="col-sm-2">
            Trạng Thái
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
    </dl>

    <form asp-action="DeleteNghiPhep" method="post">
        <input type="hidden" asp-for="MaNghiPhep" />
        <div class="form-group">
            <input type="submit" value="Xóa" class="btn btn-danger" /> |
            <a asp-action="ListNghiPhep" class="btn btn-secondary">Hủy bỏ</a>
        </div>
    </form>
</div>
