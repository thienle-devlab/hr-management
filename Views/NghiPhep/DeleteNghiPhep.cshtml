@model HR_Management.Models.Nghiphep

@{
    ViewData["Title"] = "Xóa Nghỉ Phép";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa nghỉ phép này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Nghỉ Phép</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">Chi tiết Nghỉ Phép</h5>
            <p><strong>Mã Nghỉ Phép:</strong> @Model.MaNghiPhep</p>
            <p><strong>Mã Nhân Viên:</strong> @Model.MaNhanVien</p>
            <p><strong>Ngày Bắt Đầu:</strong> @Model.NgayBatDau.ToString("yyyy-MM-dd")</p>
            <p><strong>Ngày Kết Thúc:</strong> @Model.NgayKetThuc.ToString("yyyy-MM-dd")</p>
            <p><strong>Lý Do:</strong> @Model.LyDo</p>
            <p><strong>Trạng Thái:</strong> @Model.TrangThai</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteNghiPhep">
                <input type="hidden" name="MaNghiPhep" value="@Model.MaNghiPhep" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListNghiPhep", "NghiPhep")" class="btn btn-secondary btn-lg">Hủy bỏ</a>
            </form>
        </div>
    </div>
</div>
