@model IEnumerable<HR_Management.Models.Nghiphep>

@{
    ViewData["Title"] = "Danh Sách Nghỉ Phép";
}

<h1>Danh Sách Nghỉ Phép</h1>

<table class="table">
    <thead>
        <tr>
            <th>Mã Nghỉ Phép</th>
            <th>Mã Nhân Viên</th>
            <th>Ngày Bắt Đầu</th>
            <th>Ngày Kết Thúc</th>
            <th>Lý Do</th>
            <th>Trạng Thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaNghiPhep</td>
                <td>@item.MaNhanVien</td>
                <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>@item.LyDo</td>
                <td>@item.TrangThai</td>
            </tr>
        }
    </tbody>
</table>
