@model HR_Management.Models.Nghiphep

@{
    ViewData["Title"] = "Thêm Nghỉ Phép";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="CreateNghiPhep">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Nghỉ Phép Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Nghỉ Phép -->
                <div class="form-group">
                    <label asp-for="MaNghiPhep" class="control-label">Mã Nghỉ Phép</label>
                    <input asp-for="MaNghiPhep" class="form-control" />
                    <span asp-validation-for="MaNghiPhep" class="text-danger"></span>
                </div>

                <!-- Nhân viên -->
                <div class="form-group">
                    <label for="MaNhanVien">Nhân viên</label>
                    <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList">
                        <option value="">-- Chọn nhân viên --</option>
                    </select>
                    <span asp-validation-for="MaNhanVien" class="text-danger"></span>
                </div>

                <!-- Ngày Bắt Đầu -->
                <div class="form-group">
                    <label asp-for="NgayBatDau" class="control-label">Ngày Bắt Đầu</label>
                    <input asp-for="NgayBatDau" class="form-control" type="date" />
                    <span asp-validation-for="NgayBatDau" class="text-danger"></span>
                </div>

                <!-- Ngày Kết Thúc -->
                <div class="form-group">
                    <label asp-for="NgayKetThuc" class="control-label">Ngày Kết Thúc</label>
                    <input asp-for="NgayKetThuc" class="form-control" type="date" />
                    <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                </div>

                <!-- Lý Do -->
                <div class="form-group">
                    <label asp-for="LyDo" class="control-label">Lý Do</label>
                    <textarea asp-for="LyDo" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="LyDo" class="text-danger"></span>
                </div>

                <!-- Trạng Thái -->
                <div class="form-group">
                    <label asp-for="TrangThai" class="control-label">Trạng Thái</label>
                    <input asp-for="TrangThai" class="form-control" />
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Thêm Nghỉ Phép</button>
                <a href="@Url.Action("ListNghiPhep", "NghiPhep")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}