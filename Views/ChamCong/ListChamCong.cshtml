@model IEnumerable<HR_Management.Models.Chamcong>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Chấm Công";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <p>
        <a asp-action="CreateChamCong" class="btn btn-primary mb-3">Tạo Mới Chấm Công</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Chấm Công</th>
                    <th scope="col">Mã Nhân Viên</th>
                    <th scope="col">Ngày Chấm Công</th>
                    <th scope="col">Giờ Vào</th>
                    <th scope="col">Giờ Ra</th>
                    <th scope="col">Trạng Thái</th>
                    <th scope="col">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.MaChamCong)</td>
                        <td>@Html.DisplayFor(modelItem => item.MaNhanVien)</td>
                        <td>@Html.DisplayFor(modelItem => item.NgayChamCong)</td>
                        <td>@Html.DisplayFor(modelItem => item.CheckIn)</td>
                        <td>@Html.DisplayFor(modelItem => item.CheckOut)</td>
                        <td>@Html.DisplayFor(modelItem => item.TrangThai)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("EditChamCong", new { maChamCong = item.MaChamCong })" class="btn btn-warning btn-sm">Sửa</a>
                                <a href="@Url.Action("DeleteChamCong", new { maChamCong = item.MaChamCong })" class="btn btn-danger btn-sm">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
