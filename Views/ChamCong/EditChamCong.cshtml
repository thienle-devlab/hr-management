@model HR_Management.Models.Chamcong

@{
    ViewData["Title"] = "Sửa Chấm Công";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="EditChamCong">
        <div class="card">
            <div class="card-header bg-warning text-white">
                <h4 class="card-title">Chỉnh sửa thông tin chấm công</h4>
            </div>
            <div class="card-body">

                <!-- Mã Chấm Công -->
                <div class="form-group">
                    <label asp-for="MaChamCong" class="control-label">Mã Chấm Công</label>
                    <input asp-for="MaChamCong" class="form-control" readonly />
                    <span asp-validation-for="MaChamCong" class="text-danger"></span>
                </div>

                <!-- Nhân viên -->
                <div class="form-group">
                    <label for="MaNhanVien">Nhân viên</label>
                    <select asp-for="MaNhanVien" class="form-control" asp-items="ViewBag.NhanVienList"></select>
                    <span asp-validation-for="MaNhanVien" class="text-danger"></span>
                </div>

                <!-- Ngày Chấm Công -->
                <div class="form-group">
                    <label asp-for="NgayChamCong" class="control-label">Ngày Chấm Công</label>
                    <input asp-for="NgayChamCong" class="form-control" />
                    <span asp-validation-for="NgayChamCong" class="text-danger"></span>
                </div>

                <!-- Giờ Vào -->
                <div class="form-group">
                    <label asp-for="CheckIn" class="control-label">Giờ Vào</label>
                    <input asp-for="CheckIn" class="form-control" />
                    <span asp-validation-for="CheckIn" class="text-danger"></span>
                </div>

                <!-- Giờ Ra -->
                <div class="form-group">
                    <label asp-for="CheckOut" class="control-label">Giờ Ra</label>
                    <input asp-for="CheckOut" class="form-control" />
                    <span asp-validation-for="CheckOut" class="text-danger"></span>
                </div>

                <!-- Trạng Thái -->
                <div class="form-group">
                    <label asp-for="TrangThai" class="control-label">Trạng Thái</label>
                    <input asp-for="TrangThai" class="form-control" />
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>

            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-success btn-lg">Lưu Thay Đổi</button>
                <a href="@Url.Action("ListChamCong", "ChamCong")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
