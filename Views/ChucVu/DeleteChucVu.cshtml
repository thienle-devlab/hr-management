@model HR_Management.Models.Chucvu

@{
    ViewData["Title"] = "Xóa Chức Vụ";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa chức vụ này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Chức Vụ</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.TenChucVu</h5>
            <p><strong>Mã Chức Vụ:</strong> @Model.MaChucVu</p>
            <p><strong>Tên Chức Vụ:</strong> @Model.TenChucVu</p>
            <p><strong>Phòng Ban:</strong> @Model.MaPhongBanNavigation?.TenPhongBan</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteChucVu">
                <input type="hidden" name="MaChucVu" value="@Model.MaChucVu" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListChucVu", "Chucvu")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
