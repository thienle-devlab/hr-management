@model HR_Management.Models.Chucvu

@{
    ViewData["Title"] = "Sửa Chức Vụ";
}

<h2>Sửa Chức Vụ</h2>

<form asp-action="EditChucVu" method="post">
    <input type="hidden" asp-for="MaChucVu" />

    <div class="form-group">
        <label for="TenChucVu">Tên Chức Vụ</label>
        <input type="text" asp-for="TenChucVu" class="form-control" />
        <span asp-validation-for="TenChucVu" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="MaPhongBan">Phòng Ban</label>
        <select asp-for="MaPhongBan" class="form-control" asp-items="ViewBag.PhongBanList">
            <option value="">-- Chọn Phòng Ban --</option>
        </select>
        <span asp-validation-for="MaPhongBan" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="ListChucVu" class="btn btn-secondary">Hủy</a>
</form>


