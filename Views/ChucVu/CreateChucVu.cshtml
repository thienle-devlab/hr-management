@model HR_Management.Models.Chucvu

@{
    ViewData["Title"] = "Thêm Chức Vụ";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="CreateChucVu" method="post">
    <div class="form-group">
        <label for="MaChucVu">Mã Chức Vụ</label>
        <input type="text" class="form-control" id="MaChucVu" name="MaChucVu" required />
    </div>

    <div class="form-group">
        <label for="TenChucVu">Tên Chức Vụ</label>
        <input type="text" class="form-control" id="TenChucVu" name="TenChucVu" required />
    </div>

    <div class="form-group">
        <label for="MaPhongBan">Phòng Ban</label>
        <select class="form-control" id="MaPhongBan" name="MaPhongBan">
            <option value="">Chọn phòng ban</option>
            @foreach (var phongBan in ViewBag.PhongBanList)
            {
                <option value="@phongBan.Value">@phongBan.Text</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="ListChucVu" class="btn btn-secondary">Hủy</a>
</form>