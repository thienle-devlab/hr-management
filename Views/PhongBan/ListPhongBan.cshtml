@model IEnumerable<HR_Management.Models.Phongban>

@{
    ViewData["Title"] = "Danh sách Phòng Ban";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-action="CreatePhongBan">Thêm Phòng Ban</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Mã Phòng Ban</th>
            <th>Tên Phòng Ban</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaPhongBan</td>
                <td>@item.TenPhongBan</td>
                <td>
                    <a asp-action="EditPhongBan" asp-route-id="@item.MaPhongBan">Sửa</a> |
                    <a asp-action="DeletePhongBan" asp-route-id="@item.MaPhongBan">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>