@model IEnumerable<HR_Management.Models.Phongban>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Phòng Ban";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    @if (ViewBag.IsAdmin)
    {
        <p>
            <a asp-action="CreatePhongBan" class="btn btn-primary mb-3">Thêm Mới Phòng Ban</a>
        </p>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Phòng Ban</th>
                    <th scope="col">Tên Phòng Ban</th>
                    @if (ViewBag.IsAdmin)
                    {
                        <th scope="col">Thao Tác</th>
                    }                
                </tr>
            </thead>
            <tbody>
                @foreach (var phongBan in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => phongBan.MaPhongBan)</td>
                        <td>@Html.DisplayFor(modelItem => phongBan.TenPhongBan)</td>
                        <td>
                            @if (ViewBag.IsAdmin)
                            {
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("EditPhongBan", new { maPhongBan = phongBan.MaPhongBan })" class="btn btn-warning btn-sm">Sửa</a>
                                    <a href="@Url.Action("DeletePhongBan", new { maPhongBan = phongBan.MaPhongBan })" class="btn btn-danger btn-sm">Xóa</a>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
