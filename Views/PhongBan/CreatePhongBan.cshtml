@model HR_Management.Models.Phongban

@{
    ViewData["Title"] = "Thêm Phòng Ban";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="CreatePhongBan">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Phòng Ban Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Phòng Ban -->
                <div class="form-group">
                    <label asp-for="MaPhongBan" class="control-label">Mã Phòng Ban</label>
                    <input asp-for="MaPhongBan" class="form-control" required />
                    <span asp-validation-for="MaPhongBan" class="text-danger"></span>
                </div>

                <!-- Tên Phòng Ban -->
                <div class="form-group">
                    <label asp-for="TenPhongBan" class="control-label">Tên Phòng Ban</label>
                    <input asp-for="TenPhongBan" class="form-control" required />
                    <span asp-validation-for="TenPhongBan" class="text-danger"></span>
                </div>

            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Tạo Phòng Ban</button>
                <a href="@Url.Action("ListPhongBan", "Phongban")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>
