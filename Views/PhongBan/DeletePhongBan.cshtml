@model HR_Management.Models.Phongban

@{
    ViewData["Title"] = "Xóa Phòng Ban";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa phòng ban này không?</h2>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Phòng Ban</h4>
        </div>
        <div class="card-body">
            <!-- Thông tin phòng ban -->
            <h5 class="card-title">@Model.TenPhongBan</h5>
            <p><strong>Mã Phòng Ban:</strong> @Model.MaPhongBan</p>
            <p><strong>Tên Phòng Ban:</strong> @Model.TenPhongBan</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeletePhongBan">
                <input type="hidden" name="MaPhongBan" value="@Model.MaPhongBan" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListPhongBan", "Phongban")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
