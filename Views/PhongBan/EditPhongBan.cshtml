@model HR_Management.Models.Phongban

@{
    ViewData["Title"] = "Sửa Phòng Ban";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="EditPhongBan" method="post">
    <div class="form-group">
        <label for="MaPhongBan">Mã Phòng Ban</label>
        <input type="text" class="form-control" id="MaPhongBan" name="MaPhongBan" value="@Model.MaPhongBan" readonly />
    </div>

    <div class="form-group">
        <label for="TenPhongBan">Tên Phòng Ban</label>
        <input type="text" class="form-control" id="TenPhongBan" name="TenPhongBan" value="@Model.TenPhongBan" required />
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="ListPhongBan" class="btn btn-secondary">Hủy</a>
</form>
