@model HR_Management.Models.Luongphucap

@{
    ViewData["Title"] = "Tạo Lương Phụ Cấp";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="CreateLuongPC">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Lương Phụ Cấp Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Lương Phụ Cấp -->
                <div class="form-group">
                    <label asp-for="MaLuongPhuCap" class="control-label">Mã Lương Phụ Cấp</label>
                    <input asp-for="MaLuongPhuCap" class="form-control" />
                    <span asp-validation-for="MaLuongPhuCap" class="text-danger"></span>
                </div>

                <!-- Mã Lương -->
                <div class="form-group">
                    <label for="MaLuong">Mã Lương</label>
                    <select asp-for="MaLuong" class="form-control" asp-items="ViewBag.LuongList">
                        <option value="">-- Chọn mã lương --</option>
                    </select>
                    <span asp-validation-for="MaLuong" class="text-danger"></span>
                </div>

                <!-- Mã Phụ Cấp -->
                <div class="form-group">
                    <label for="MaPhuCap">Mã Phụ Cấp</label>
                    <select asp-for="MaPhuCap" class="form-control" asp-items="ViewBag.PhuCapList">
                        <option value="">-- Chọn phụ cấp --</option>
                    </select>
                    <span asp-validation-for="MaPhuCap" class="text-danger"></span>
                </div>

                <!-- Số Tiền Phụ Cấp -->
                <div class="form-group">
                    <label for="SoTienPhuCap">Số Tiền Phụ Cấp</label>
                    <input asp-for="SoTienPhuCap" class="form-control" />
                    <span asp-validation-for="SoTienPhuCap" class="text-danger"></span>
                </div>

                <!-- Ngày Áp Dụng -->
                <div class="form-group">
                    <label for="NgayApDung">Ngày Áp Dụng</label>
                    <input asp-for="NgayApDung" class="form-control" type="date" />
                    <span asp-validation-for="NgayApDung" class="text-danger"></span>
                </div>

            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Tạo Lương Phụ Cấp</button>
                <a href="@Url.Action("ListLuongPC", "Luongphucap")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
