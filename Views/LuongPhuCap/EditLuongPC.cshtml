@model HR_Management.Models.Luongphucap

@{
    ViewData["Title"] = "Sửa Lương Phụ Cấp";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="EditLuongPC">
        <div class="card">
            <div class="card-header bg-warning text-white">
                <h4 class="card-title">Chỉnh sửa thông tin lương phụ cấp</h4>
            </div>
            <div class="card-body">

                <!-- Mã Lương Phụ Cấp -->
                <div class="form-group">
                    <label asp-for="MaLuongPhuCap" class="control-label">Mã Lương Phụ Cấp</label>
                    <input asp-for="MaLuongPhuCap" class="form-control" readonly />
                    <span asp-validation-for="MaLuongPhuCap" class="text-danger"></span>
                </div>

                <!-- Mã Lương -->
                <div class="form-group">
                    <label for="MaLuong">Mã Lương</label>
                    <select asp-for="MaLuong" class="form-control" asp-items="ViewBag.LuongList"></select>
                    <span asp-validation-for="MaLuong" class="text-danger"></span>
                </div>

                <!-- Mã Phụ Cấp -->
                <div class="form-group">
                    <label for="MaPhuCap">Mã Phụ Cấp</label>
                    <select asp-for="MaPhuCap" class="form-control" asp-items="ViewBag.PhuCapList"></select>
                    <span asp-validation-for="MaPhuCap" class="text-danger"></span>
                </div>

                <!-- Số Tiền Phụ Cấp -->
                <div class="form-group">
                    <label for="SoTienPhuCap">Số Tiền Phụ Cấp</label>
                    <input asp-for="SoTienPhuCap" class="form-control" />
                    <span asp-validation-for="SoTienPhuCap" class="text-danger"></span>
                </div>

                <!-- Ngày Áp Dụng -->
                <div class="form-group">
                    <label for="NgayApDung">Ngày Áp Dụng</label>
                    <input asp-for="NgayApDung" class="form-control" type="date" />
                    <span asp-validation-for="NgayApDung" class="text-danger"></span>
                </div>

            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-success btn-lg">Lưu Thay Đổi</button>
                <a href="@Url.Action("ListLuongPC", "Luongphucap")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
