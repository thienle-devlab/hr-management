@model HR_Management.Models.Luongphucap

@{
    ViewData["Title"] = "Xóa Lương Phụ Cấp";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa lương phụ cấp này không?</h2>
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Lương Phụ Cấp</h4>
        </div>
        <div class="card-body">
            <!-- Nhân Viên -->
            <p><strong>Mã Nhân Viên:</strong> @Model.MaNhanVien</p>

            <!-- Mã Phụ Cấp -->
            <p><strong>Mã Phụ Cấp:</strong> @Model.MaPhuCap</p>

            <!-- Số Tiền Phụ Cấp -->
            <p><strong>Số Tiền Phụ Cấp:</strong> @Model.SoTienPhuCap</p>

            <!-- Ngày Áp Dụng -->
            <p><strong>Ngày Áp Dụng:</strong> @Model.NgayApDung.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeleteLuongPC">
                <input type="hidden" name="MaLuongPhuCap" value="@Model.MaLuongPhuCap" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListLuongPC", "Luongphucap")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>
