
@model IEnumerable<HR_Management.Models.Luongphucap>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh Sách Lương Phụ Cấp";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <p>
        <a asp-action="CreateLuongPC" class="btn btn-primary mb-3">Tạo Mới Lương Phụ Cấp</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-light">
                <tr>
                    <th scope="col">Mã Lương Phụ Cấp</th>
                    <th scope="col">Mã Lương</th>
                    <th scope="col">Mã Phụ Cấp</th>
                    <th scope="col">Số Tiền Phụ Cấp</th>
                    <th scope="col">Ngày Áp Dụng</th>
                    <th scope="col">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.MaLuongPhuCap)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.MaLuong)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.MaPhuCap)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SoTienPhuCap)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.NgayApDung)
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("EditLuongPC", new { maLuongPhuCap = item.MaLuongPhuCap })" class="btn btn-warning btn-sm">Sửa</a>
                                <a href="@Url.Action("DeleteLuongPC", new { maLuongPhuCap = item.MaLuongPhuCap })" class="btn btn-danger btn-sm">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
