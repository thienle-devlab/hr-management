@model HR_Management.Models.Phucap

@{
    ViewData["Title"] = "Thêm Phụ Cấp";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="Create">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="card-title">Thêm Phụ Cấp Mới</h4>
            </div>
            <div class="card-body">

                <!-- Mã Phụ Cấp -->
                <div class="form-group">
                    <label asp-for="MaPhuCap" class="control-label">Mã Phụ Cấp</label>
                    <input asp-for="MaPhuCap" class="form-control" />
                    <span asp-validation-for="MaPhuCap" class="text-danger"></span>
                </div>

                <!-- Tên Phụ Cấp -->
                <div class="form-group">
                    <label asp-for="TenPhuCap" class="control-label">Tên Phụ Cấp</label>
                    <input asp-for="TenPhuCap" class="form-control" />
                    <span asp-validation-for="TenPhuCap" class="text-danger"></span>
                </div>

            </div>

            <div class="card-footer text-center">
                <button type="submit" class="btn btn-primary btn-lg">Thêm Phụ Cấp</button>
                <a href="@Url.Action("ListPhuCap", "Phucap")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
