@model HR_Management.Models.Phucap

@{
    ViewData["Title"] = "Xóa Phụ Cấp";
}

<div class="container mt-4">
    <h2 class="text-danger">Bạn có chắc chắn muốn xóa phụ cấp này không?</h2>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title">Xóa Phụ Cấp</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title">@Model.TenPhuCap</h5>
            <p><strong>Mã Phụ Cấp:</strong> @Model.MaPhuCap</p>
        </div>
        <div class="card-footer text-center">
            <form method="post" asp-action="DeletePhuCap">
                <input type="hidden" name="MaPhuCap" value="@Model.MaPhuCap" />
                <button type="submit" class="btn btn-danger btn-lg mr-3">Xóa</button>
                <a href="@Url.Action("ListPhuCap", "Phucap")" class="btn btn-secondary btn-lg">Hủy</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
