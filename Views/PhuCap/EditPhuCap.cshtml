@model HR_Management.Models.Phucap

@{
    ViewData["Title"] = "Sửa Phụ cấp";
}

<h2>@ViewData["Title"]</h2>

<h4>PhuCap</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditPhuCap">
            <div class="form-group">
                <label asp-for="MaPhuCap" class="control-label"></label>
                <input asp-for="MaPhuCap" class="form-control" readonly />
                <span asp-validation-for="MaPhuCap" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TenPhuCap" class="control-label"></label>
                <input asp-for="TenPhuCap" class="form-control" />
                <span asp-validation-for="TenPhuCap" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
